{
  "name": "jobarms-render",
  "version": "0.1.0",
  "description": "JobArms render sidecar - persistent Playwright browser for login-gated and multi-page ATS applications",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "check": "tsc --noEmit",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "express": "^5.2.0",
    "express-rate-limit": "^8.4.0",
    "playwright": "^1.58.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.1.4",
    "tsx": "^4.20.9",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
