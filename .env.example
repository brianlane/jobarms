# JobArms environment - copy to .env (gitignored) and fill in.
# Local .env is the single source of truth; GitHub Actions secrets and Vercel
# env vars are set FROM these values (see README "CI/CD").

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin console (/admin) ---
# ADMIN_EMAIL is the entire allowlist (comma-separated for more than one). Unset
# means the admin console is disabled. Nothing in the database grants admin.
# ADMIN_PASSWORD is only used by scripts/oneshot/create-admin.ts to create or
# reset that Supabase account; application code never reads it.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Supabase (project settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...            # server-only, bypasses RLS
SUPABASE_DB_PASSWORD=                        # for CLI migrations (CI drift/deploy)
SUPABASE_ACCESS_TOKEN=sbp_...                # personal access token (CI supabase link)
# Legacy JWT-shaped keys (kept for tools that don't speak sb_* keys yet):
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_SECRET=

# --- Gemini (Google AI Studio "Job Arms" project, PAID tier) ---
GEMINI_API_KEY=

# --- Stripe (test mode until launch) ---
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...              # minted when the webhook endpoint is registered
STRIPE_PRICE_PREMIUM_MONTHLY=price_...       # created by scripts/oneshot/create-stripe-prices.ts
STRIPE_PRICE_MAX_MONTHLY=price_...           # created by scripts/oneshot/create-stripe-price-max.ts

# --- Vercel (CI deploys; also set as GitHub Actions secrets) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Internal shared secrets (generate: openssl rand -hex 32) ---
INTERNAL_CRON_SECRET=                        # auths cron/manual triggers -> internal endpoints
ARM_WORKER_SHARED_SECRET=                    # auths app <-> Cloudflare apply-arm worker

# --- Apply-arm worker location (set after the Phase 3 first deploy) ---
ARM_WORKER_URL=                              # e.g. https://jobarms-apply-arm.<account>.workers.dev

# --- Email (Phase 1) ---
RESEND_API_KEY=

# --- Render sidecar (the arm's browser; see vps/render) ---
RENDER_URL=                                  # e.g. https://browser.jobarms.com
RENDER_TOKEN=                                # shared bearer; openssl rand -hex 32

# --- ATS account vault ---
# Encrypts generated passwords for candidate accounts on employer tenants BEFORE
# they reach Postgres (AES-256-GCM). MUST be 32 bytes as hex:
#   openssl rand -hex 32
# Rotating it orphans every stored credential (accounts must be re-created), so
# treat it as permanent.
SITE_ACCOUNT_ENC_KEY=

# --- Inbound email (managed applicant mailboxes) ---
# Shared bearer between the jobarms-email-inbound Cloudflare Email Worker and
# the app's /api/email/inbound webhook. Generate: openssl rand -hex 32
# Set in BOTH places: Vercel env + `wrangler secret put` on email-inbound.
EMAIL_INBOUND_SECRET=

# --- Cloudflare (Phase 3: worker deploys from CI) ---
CLOUDFLARE_API_TOKEN=
